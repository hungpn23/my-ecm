{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}", "**/templates/*.tsx"],
  "workspaces": {
    "patterns": ["apps/*", "libs/*"]
  },
  "ignorePatterns": ["docs/**", "scripts/**", "tools/**", "**/migration/**"],
  "ignoreFindings": ["**/mikro-orm.config.ts", "**/*.generated.ts"],
  "ignoreDependencies": [
    "@mikro-orm/cli",
    "pino-pretty",
    "@oxlint/plugins",
    "@react-email/ui",
    "@ark/util",
    "@clack/prompts"
  ],
  "duplicates": {
    "mode": "weak",
    "minOccurrences": 3,
    "ignore": ["apps/*/src/main.ts", "apps/*/src/app.module.ts"]
  },
  "rules": {
    "unused-class-members": "off"
  }
}
