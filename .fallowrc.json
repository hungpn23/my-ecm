{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "workspaces": { "patterns": ["apps/*", "libs/*"] },
  "ignorePatterns": ["scripts/**", "tools/**", "**/migration/**"],
  "ignoreFindings": ["**/mikro-orm.config.ts", "**/*.generated.ts"],
  "ignoreDependencies": ["@mikro-orm/cli", "pino-pretty", "@oxlint/plugins"],
  "duplicates": {
    "mode": "weak",
    "minOccurrences": 3
  },
  "rules": {}
}
