{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".react-email/**"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "discovery:export": {
      "dependsOn": ["^discovery:export"]
    },
    "migration:down": {
      "dependsOn": ["^migration:down"]
    },
    "migration:up": {
      "dependsOn": ["^migration:up"]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "APP_HOST",
    "JWT_ALGORITHM",
    "JWT_ISSUER",
    "JWT_AUDIENCE",
    "JWT_SECRET",
    "JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS",
    "JWT_REFRESH_TOKEN_EXPIRES_IN_SECONDS",
    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASSWORD",
    "DB_ENABLE_DEBUG",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_USERNAME",
    "REDIS_PASSWORD",
    "APISIX_PORT",
    "KAFKA_HOST",
    "KAFKA_PORT",
    "KAFKA_SESSION_TIMEOUT",
    "KAFKA_HEARTBEAT_INTERVAL",
    "KAFKA_REBALANCE_TIMEOUT",
    "KAFKA_MAX_WAIT_TIME",
    "KAFKAJS_NO_PARTITIONER_WARNING"
  ]
}
