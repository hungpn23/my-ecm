{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".react-email/**"]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "check:auth-store": {
      "cache": false,
      "env": ["AUTH_STORE_TEST_DATABASE"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "discovery:export": {
      "dependsOn": ["^discovery:export"],
      "cache": false
    },
    "migration:down": {
      "dependsOn": ["^migration:down"],
      "cache": false
    },
    "migration:create": {
      "cache": false
    },
    "migration:up": {
      "dependsOn": ["^migration:up"],
      "cache": false
    },
    "orm:debug": {
      "dependsOn": ["^orm:debug"],
      "cache": false
    },
    "register:debezium": {
      "dependsOn": ["^register:debezium"],
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "APP_HOST",
    "IDENTITY_SERVICE_URL",
    "AUTH_INTERNAL_SECRET",
    "AUTH_JWT_PUBLIC_KEY_PATH",
    "AUTH_JWT_ISSUER",
    "AUTH_JWT_AUDIENCE",
    "DB_HOST",
    "DB_PORT",
    "DB_USER",
    "DB_PASSWORD",
    "DB_ENABLE_DEBUG",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_USERNAME",
    "REDIS_PASSWORD",
    "APISIX_PORT",
    "KAFKA_HOST",
    "KAFKA_PORT",
    "KAFKA_SESSION_TIMEOUT",
    "KAFKA_HEARTBEAT_INTERVAL",
    "KAFKA_REBALANCE_TIMEOUT",
    "KAFKA_MAX_WAIT_TIME",
    "KAFKA_UI_PORT",
    "KAFKA_CONNECT_PORT",
    "KAFKAJS_NO_PARTITIONER_WARNING",
    "AWS_REGION",
    "AWS_ENDPOINT_URL",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY"
  ]
}
