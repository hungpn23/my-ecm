{
  "name": "@apps/identity-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "check:types": "tsc",
    "dev": "bun --watch src/main.ts",
    "discovery:export": "bun -b mikro-orm discovery:export",
    "migration:down": "bun -b mikro-orm migration:down",
    "migration:up": "bun -b mikro-orm migration:up",
    "start": "bun src/main.ts"
  },
  "dependencies": {
    "@libs/common": "workspace:*",
    "@libs/core": "workspace:*",
    "@mikro-orm/cli": "catalog:mikro",
    "@mikro-orm/core": "catalog:mikro",
    "@mikro-orm/migrations": "catalog:mikro",
    "@mikro-orm/nestjs": "catalog:mikro",
    "@mikro-orm/postgresql": "catalog:mikro",
    "@nestjs/common": "catalog:nest",
    "@nestjs/config": "catalog:nest",
    "@nestjs/core": "catalog:nest",
    "@nestjs/jwt": "catalog:auth",
    "@nestjs/microservices": "catalog:nest",
    "@nestjs/passport": "catalog:auth",
    "@nestjs/platform-express": "catalog:nest",
    "@nestjs/swagger": "catalog:nest",
    "argon2": "catalog:auth",
    "arkenv": "catalog:common",
    "arktype": "catalog:common",
    "dotenv": "catalog:backend",
    "kafkajs": "catalog:backend",
    "nestjs-pino": "catalog:logging",
    "passport-github2": "catalog:auth",
    "passport-google-oauth20": "catalog:auth",
    "passport-jwt": "catalog:auth",
    "reflect-metadata": "catalog:backend",
    "rxjs": "catalog:backend",
    "uuid": "catalog:backend"
  },
  "devDependencies": {
    "@types/passport-github2": "catalog:auth",
    "@types/passport-google-oauth20": "catalog:auth",
    "@types/passport-jwt": "catalog:auth"
  }
}
