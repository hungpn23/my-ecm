{
  "name": "my-ecm",
  "private": true,
  "workspaces": {
    "catalogs": {
      "nest": {
        "@nestjs/common": "12.2.0",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "12.2.0",
        "@nestjs/microservices": "12.2.0",
        "@nestjs/platform-express": "12.2.0",
        "@nestjs/swagger": "12.0.4",
        "@nestjs/observe": "0.3.17"
      },
      "mikro": {
        "@mikro-orm/cli": "7.2.5",
        "@mikro-orm/core": "7.2.5",
        "@mikro-orm/migrations": "7.2.5",
        "@mikro-orm/nestjs": "7.1.0",
        "@mikro-orm/postgresql": "7.2.5",
        "@mikro-orm/seeder": "7.2.5",
        "@mikro-orm/sql-highlighter": "1.0.1"
      },
      "auth": {
        "@nestjs/authentication": "0.1.1",
        "@nestjs/authorization": "^0.1.0"
      },
      "logging": {
        "nestjs-pino": "5.3.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "pino-pretty": "13.1.3"
      },
      "backend": {
        "dotenv": "18.0.9",
        "dotenv-cli": "11.0.0",
        "ioredis": "6.0.0",
        "kafkajs": "2.2.4",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "uuid": "14.0.3"
      },
      "common": {
        "@ark/util": "0.56.8",
        "@arkenv/core": "1.0.0-rc.4",
        "@types/lodash": "4.17.27",
        "arktype": "2.2.9",
        "lodash": "4.18.1"
      },
      "email": {
        "@nestjs/mail": "^0.0.1",
        "@react-email/ui": "6.11.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-email": "6.11.3"
      }
    },
    "packages": [
      "apps/*",
      "libs/*"
    ]
  },
  "type": "module",
  "scripts": {
    "check:all": "bun check:fix && bun check:types && bun check:fallow && bun check:env",
    "check:auth-store": "dotenv -e .env -- turbo check:auth-store --filter=@apps/identity-service",
    "check:env": "bun scripts/check:env.ts",
    "check:fallow": "bunx fallow --skip health",
    "check:fix": "bun fmt && bun lint --fix",
    "check:types": "bun check && turbo check:types",
    "clean": "rimraf --glob '**/node_modules' '**/.turbo' '**/dist' '**/.react-email' bun.lock",
    "dev": "dotenv -e .env -- turbo dev",
    "dev:select": "bun scripts/dev:select.ts",
    "discovery:export": "turbo discovery:export",
    "email:dev": "bun --filter @libs/email email:dev",
    "migration:create": "turbo migration:create",
    "migration:down": "turbo migration:down",
    "migration:up": "turbo migration:up",
    "onboard:service": "bun scripts/onboard:service.ts",
    "orm:debug": "turbo orm:debug",
    "prepare": "bun .husky/install.mjs",
    "register:debezium": "dotenv -e .env -- turbo register:debezium",
    "setup": "bun i && bun scripts/setup.ts"
  },
  "dependencies": {
    "dotenv-cli": "catalog:backend"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "fallow": "3.36.0",
    "husky": "9.1.7",
    "rimraf": "6.1.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4-canary.1"
}
