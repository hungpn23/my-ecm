{
  "name": "my-ecm",
  "private": true,
  "workspaces": {
    "catalogs": {
      "backend": {
        "@mikro-orm/cli": "^7.1.14",
        "@mikro-orm/core": "^7.1.14",
        "@mikro-orm/migrations": "^7.1.14",
        "@mikro-orm/nestjs": "^7.0.2",
        "@mikro-orm/postgresql": "^7.1.14",
        "@mikro-orm/seeder": "^7.1.14",
        "@mikro-orm/sql-highlighter": "^1.0.1",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/jwt": "^12.0.1",
        "@nestjs/microservices": "^12.0.1",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.0.1",
        "@nestjs/swagger": "^12.0.1",
        "@oxc-node/core": "^0.1.0",
        "argon2": "^0.45.1",
        "dotenv": "^17.4.2",
        "dotenv-cli": "^11.0.0",
        "ioredis": "^6.0.0",
        "nestjs-pino": "^4.6.1",
        "passport": "^0.7.0",
        "passport-custom": "^1.1.1",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "uuid": "^14.0.2"
      },
      "common": {
        "arkenv": "^0.12.3",
        "arktype": "^2.2.3",
        "lodash": "^4.18.1"
      },
      "dev": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/schematics": "^12.0.0",
        "@types/bun": "^1.4.0",
        "@types/express": "^5.0.6",
        "@types/lodash": "^4.17.25",
        "@types/passport-github2": "^1.2.9",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/passport-jwt": "^4.0.1",
        "typescript": "^7.0.2"
      }
    },
    "packages": [
      "apps/*",
      "libs/*"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check:all": "bun check:lint && bun check:types && bun check:env",
    "check:env": "bun scripts/check-global-env.ts",
    "check:fix": "oxfmt --write && oxlint --fix",
    "check:lint": "oxfmt --check && oxlint",
    "check:types": "tsc --noEmit && turbo check:types",
    "clean": "rimraf --glob '**/node_modules' '**/.turbo' '**/dist' bun.lock",
    "dev": "dotenv -e .env -- turbo dev",
    "lint-staged": "lint-staged",
    "prepare": "bun .husky/install.mjs",
    "setup": "bun scripts/setup.ts && bun i"
  },
  "dependencies": {
    "dotenv-cli": "catalog:backend",
    "pino": "catalog:backend"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:dev",
    "@nestjs/schematics": "catalog:dev",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "catalog:dev",
    "@types/lodash": "catalog:dev",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "typescript": "catalog:dev"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,yml,yaml}": "oxfmt --write",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  },
  "packageManager": "bun@1.4.0"
}
