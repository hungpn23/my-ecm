{
  "name": "my-ecm",
  "private": true,
  "workspaces": {
    "catalogs": {
      "backend": {
        "@mikro-orm/cli": "^7.1.5",
        "@mikro-orm/core": "^7.1.5",
        "@mikro-orm/migrations": "^7.1.5",
        "@mikro-orm/nestjs": "^7.0.2",
        "@mikro-orm/postgresql": "^7.1.5",
        "@mikro-orm/seeder": "^7.1.5",
        "@mikro-orm/sql-highlighter": "^1.0.1",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/microservices": "^11.1.19",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.0",
        "@oxc-node/core": "^0.1.0",
        "dotenv": "^17.4.2",
        "passport": "^0.7.0",
        "passport-custom": "^1.1.1",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "reflect-metadata": "^0.2.2",
        "argon2": "^0.44.0",
        "rxjs": "^7.8.1",
        "uuid": "^14.0.1",
        "ioredis": "^5.11.1"
      },
      "common": {
        "arkenv": "^0.11.0",
        "arktype": "^2.2.0"
      },
      "dev": {
        "@types/bun": "1.3.5",
        "@types/passport-github2": "^1.2.9",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "typescript": "^7.0.2"
      }
    },
    "packages": [
      "apps/*",
      "libs/*"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "oxfmt && oxlint",
    "check-types": "turbo run check-types",
    "check:fix": "oxfmt --write && oxlint --fix",
    "clean": "rimraf --glob '**/node_modules' '**/.turbo' '**/dist' bun.lock",
    "dev": "turbo run dev",
    "generate-jwt-keypair": "bun scripts/generate-jwt-keypair.ts",
    "prepare": "bun .husky/install.mjs",
    "setup": "bun scripts/init.ts && bun i"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "catalog:dev",
    "@types/passport-github2": "catalog:dev",
    "@types/passport-google-oauth20": "catalog:dev",
    "@types/passport-jwt": "catalog:dev",
    "@types/passport-local": "catalog:dev",
    "husky": "^9.1.7",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.6",
    "typescript": "catalog:dev"
  },
  "packageManager": "bun@1.3.5"
}
