# This file is used to define environment variables for Docker containers.

NODE_ENV=production
APP_HOST=0.0.0.0

IDENTITY_SERVICE_TCP_HOST=identity-service
PRODUCT_SERVICE_TCP_HOST=product-service
NOTIFICATION_SERVICE_TCP_HOST=notification-service
ORDER_SERVICE_TCP_HOST=order-service
INVENTORY_SERVICE_TCP_HOST=inventory-service
PAYMENT_SERVICE_TCP_HOST=payment-service
SHIPPING_SERVICE_TCP_HOST=shipping-service

DB_HOST=db
DB_PORT=5432

AUTH_JWT_PUBLIC_KEY_PATH=/run/keys/identity-ed25519-public.pem
AUTH_JWT_PRIVATE_KEY_PATH=/run/keys/identity-ed25519-private.pem
